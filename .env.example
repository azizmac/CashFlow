# Скопируйте в .env и заполните. .env не коммитится.
POSTGRES_PASSWORD=change-me-strong-password
# 32 байта в base64: openssl rand -base64 32   (PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]]))
ENCRYPTION_MASTER_KEY=
WEB_PORT=8080
# Порт PostgreSQL на хосте: к нему подключается настольное приложение (встроенный сервер). Только localhost.
DB_PORT=127.0.0.1:55432
SYNC_INTERVAL_HOURS=6
CASHFLOW_TZ=Europe/Moscow

# --- Демо-пользователь для локальных проверок (необязательно) ---
# Сервер создаст пользователя при старте; вход — кнопкой «Войти как демо» в приложении или по http://localhost:8080/dev/login.
# Пароль по правилам Identity: от 10 символов, заглавная и строчная буквы, цифра, спецсимвол (напр. Demo-cashflow-2026).
# Пароль виден всем, кто читает этот файл: НЕ задавать на сервере, доступном из сети.
DEMO_EMAIL=
DEMO_PASSWORD=

# --- Подключение банков через авторизацию (необязательно) ---
# Публичный адрес сервера для redirect URI (если за reverse proxy / домен), напр. https://cashflow.example.com
PUBLIC_BASE_URL=
# Sber API, прямая интеграция (СберБизнес → Интеграции → Sber API): реквизиты приложения + сертификат mTLS
SBER_CLIENT_ID=
SBER_CLIENT_SECRET=
SBER_CERT_PFX_PATH=/secrets/sber.pfx
SBER_CERT_PASSWORD=
# Alfa API (developers.alfabank.ru): реквизиты приложения
ALFA_CLIENT_ID=
ALFA_CLIENT_SECRET=
# T-ID / T-Business ID (только партнёрам Т-Банка; для своего ИП используйте токен из ЛК)
TBANK_CLIENT_ID=
TBANK_CLIENT_SECRET=
