# Скопируйте в .env и заполните. .env не коммитится.
POSTGRES_PASSWORD=change-me-strong-password
# 32 байта в base64: openssl rand -base64 32   (PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]]))
ENCRYPTION_MASTER_KEY=
WEB_PORT=8080
SYNC_INTERVAL_HOURS=6
CASHFLOW_TZ=Europe/Moscow
