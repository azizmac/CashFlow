@inherits LayoutComponentBase
@inject IAppShell Shell
@inject ThemeService Theme

<AuthorizeView>
    <Authorized>
        <div class="shell">
            <aside class="side">
                <div class="brand">CashFlow AI</div>
                <nav>
                    <NavLink href="/" Match="NavLinkMatch.All"><span class="ico">◍</span>Обзор</NavLink>
                    <NavLink href="/transactions"><span class="ico">≡</span>Операции</NavLink>
                    <NavLink href="/categories"><span class="ico">◑</span>Категории</NavLink>
                    <NavLink href="/counterparties"><span class="ico">◇</span>Контрагенты</NavLink>
                    <NavLink href="/accounts"><span class="ico">◫</span>Счета</NavLink>
                    <NavLink href="/sources"><span class="ico">⇪</span>Импорт</NavLink>
                    <NavLink href="/connections"><span class="ico">⟳</span>Подключения</NavLink>
                    <NavLink href="/settings"><span class="ico">⚙</span>Настройки</NavLink>
                </nav>
                <div class="user">
                    <span class="who" title="@context.User.Identity?.Name">@context.User.Identity?.Name</span>
                    @if (Shell.IsBrowserHosted)
                    {
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="/" />
                            <button type="submit" class="link">Выйти</button>
                        </form>
                    }
                    else
                    {
                        <button class="link" @onclick="Shell.LogoutAsync">Выйти</button>
                    }
                </div>
                <div class="foot">только чтение · данные не покидают ваш сервер</div>
            </aside>
            <main class="main">
                @Body
            </main>
        </div>
        <nav class="tabbar">
            <NavLink href="/" Match="NavLinkMatch.All"><span class="ico">◍</span>Обзор</NavLink>
            <NavLink href="/transactions"><span class="ico">≡</span>Операции</NavLink>
            <NavLink href="/sources" class="fab" title="Загрузить выписку"><span class="ico">⇪</span></NavLink>
            <NavLink href="/accounts"><span class="ico">◫</span>Счета</NavLink>
            <NavLink href="/settings"><span class="ico">⚙</span>Ещё</NavLink>
        </nav>
    </Authorized>
    <NotAuthorized>
        @* Экран входа/регистрации: без навигации, по центру, как в онбординге макета *@
        <main class="main auth">
            @Body
        </main>
    </NotAuthorized>
</AuthorizeView>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Theme.ApplyStoredAsync();
    }
}
