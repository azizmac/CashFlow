@page "/counterparties"
@attribute [Authorize]
@inject ICurrentUser Me
@inject ILedgerQueries Q

<PageTitle>Контрагенты — CashFlow</PageTitle>

<PageHead Eyebrow="Counterparties" Title="Контрагенты" />

<div class="search" style="margin-bottom:12px">
    <Icon Name="search" Size="15" />
    <input placeholder="Название, ИНН" @bind="search" @bind:after="Reload" />
</div>

<div class="chips" style="margin-bottom:14px">
    <span class="chip @(kind is null ? "on" : "")" @onclick="() => SetKind(null)">Все</span>
    @foreach (var k in new[] { CounterpartyKind.Merchant, CounterpartyKind.Company, CounterpartyKind.SoleProprietor, CounterpartyKind.Person, CounterpartyKind.Government, CounterpartyKind.Bank, CounterpartyKind.Self })
    {
        <span class="chip @(kind == k ? "on" : "")" @onclick="() => SetKind(k)">@Label(k)</span>
    }
</div>

@if (rows.Count == 0)
{
    <div class="card empty"><div class="icon"><Icon Name="counterparties" Size="20" /></div><div class="ttl">Контрагентов пока нет</div><p>Они появятся после загрузки первой выписки: имена, ИНН и счета берутся из назначения платежей.</p><div class="actions"><a class="btn small" href="/sources"><Icon Name="import" Size="14" /> Загрузить выписку</a></div></div>
}
else
{
    <div class="card tight">
        <div class="section">Top by spend</div>
        <div class="list">
            @foreach (var c in rows.OrderByDescending(c => c.Out).ThenByDescending(c => c.In))
            {
                <a class="item clickable" href="/counterparties/@c.Counterparty.Id">
                    <Avatar Name="@c.Counterparty.DisplayName" />
                    <div class="grow">
                        <div class="ttl">@c.Counterparty.DisplayName @if (c.Counterparty.IsFavorite) { <span>★</span> }</div>
                        <div class="sub">@Ui.KindLabel(c.Counterparty.Kind)@(c.Counterparty.Inn is not null ? $" · ИНН {c.Counterparty.Inn}" : "") · @c.Count @Home.Plural(c.Count, "операция", "операции", "операций")</div>
                    </div>
                    <div class="right">
                        @if (c.Out > 0) { <div class="amt num">−@Ui.N0(c.Out)</div> }
                        @if (c.In > 0) { <div class="@(c.Out > 0 ? "sub" : "amt") pos num">+@Ui.N0(c.In)</div> }
                    </div>
                    <Icon Name="chevron" Size="14" Class="chev" />
                </a>
            }
        </div>
    </div>
}

@code {
    IReadOnlyList<CounterpartyStatsDto> rows = [];
    string? search;
    CounterpartyKind? kind;
    string uid = "";

    protected override async Task OnInitializedAsync() { uid = await Me.IdAsync(); await Reload(); }

    Task SetKind(CounterpartyKind? k) { kind = k; return Reload(); }
    async Task Reload() => rows = await Q.CounterpartiesAsync(uid, search, kind);

    public static string Label(CounterpartyKind k) => k switch
    {
        CounterpartyKind.Person => "Люди", CounterpartyKind.Company => "Компании", CounterpartyKind.SoleProprietor => "ИП",
        CounterpartyKind.Bank => "Банки", CounterpartyKind.Government => "Государство", CounterpartyKind.Merchant => "Магазины", CounterpartyKind.Self => "Свои счета", _ => "Не определён"
    };
}
