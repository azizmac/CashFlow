@page "/connections"
@attribute [Authorize]
@inject ICurrentUser Me
@inject IConnectionsService Svc
@inject IAppShell Shell

<PageTitle>Подключения — CashFlow</PageTitle>

<PageHead Eyebrow="Connections" Title="Подключения">
    <Sub>Только чтение. Токены шифруются и хранятся на вашем сервере. Запрашивайте у банка доступ с минимальными правами: счета и выписки.</Sub>
</PageHead>

@if (profiles is null) { <Skeleton Rows="2" Hero="120" /> return; }

@if (msg is not null) { <div class="alert @msgCss">@msg</div> }

<div class="stack">
    @if (connections.Count > 0)
    {
        <div class="grid3">
            @foreach (var c in connections)
            {
                <div class="card @(c.Status == ConnectionStatus.Error || c.Status == ConnectionStatus.NeedsReauth ? "stale" : "")">
                    <div class="row" style="align-items:flex-start">
                        <div class="icon lg">@Glyph(c)</div>
                        <div class="grow">
                            <div style="font-weight:640">@c.Name</div>
                            <div class="muted" style="font-size:12px">@c.ProfileName · @TypeLabel(c.Type)@(c.SourceCode is not null ? $" · {c.SourceCode}" : "")</div>
                        </div>
                        <span class="pill @(c.Status == ConnectionStatus.Active ? "ok" : c.Status == ConnectionStatus.Disabled ? "" : "warn")">@Status(c.Status)</span>
                    </div>
                    <div class="small-note" style="margin-top:10px">
                        @(c.IsStatementImport ? "последняя загрузка" : "последняя синхронизация"): @(c.LastSyncAt?.Local().ToString("dd.MM.yyyy HH:mm") ?? "—")
                        @if (c.SyncCursor is not null && c.IsStatementImport) { <span> · данные по @c.SyncCursor</span> }
                        @if (c.LastError is not null) { <div style="margin-top:4px">@c.LastError</div> }
                    </div>
                    <div class="wrap" style="margin-top:10px">
                        @if (c.IsStatementImport)
                        {
                            <a class="btn small" href="/sources">Загрузить ещё</a>
                        }
                        else if (c.Status != ConnectionStatus.Disabled)
                        {
                            <button class="small primary" @onclick="() => Sync(c)" disabled="@(busyId == c.Id)">@(busyId == c.Id ? "…" : "Синхронизировать")</button>
                            <button class="small" @onclick="() => Delete(c)">Удалить</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <div>
        <h2>Подключите банк</h2>
        <div class="grid3">
            @foreach (var oc in oauth)
            {
                <div class="card">
                    <div class="row"><div class="icon lg">@Ui.Initial(oc.ProviderDisplayName)</div><div class="grow"><div style="font-weight:640">@oc.ProviderDisplayName</div><div class="muted" style="font-size:12px">вход на странице банка, токены получит сервер</div></div></div>
                    <div class="small-note" style="margin-top:10px">@oc.SetupHint</div>
                    <div style="margin-top:12px"><button class="primary small" @onclick="() => StartOAuth(oc)">Подключить</button></div>
                </div>
            }
            @if (oauth.Count == 0)
            {
                <div class="card dashed">
                    <div style="font-weight:640">Через авторизацию в банке</div>
                    <div class="small-note" style="margin-top:6px">СберБизнес ID и T-Business ID появятся здесь, когда в конфигурации сервера заданы реквизиты приложения банка — см. README, раздел «Интеграции через OAuth».</div>
                </div>
            }
            <div class="card">
                <div class="row"><div class="icon lg">⌘</div><div class="grow"><div style="font-weight:640">По токену</div><div class="muted" style="font-size:12px">T-Invest, T-API, Sber API</div></div></div>
                <div style="margin-top:12px"><button class="small" @onclick="() => showToken = !showToken">@(showToken ? "Скрыть" : "Настроить")</button></div>
            </div>
        </div>
    </div>

    @if (oauth.Count > 0 && profiles.Count > 1)
    {
        <div class="wrap">
            <Dropdown Pill Prefix="Профиль" Value="@oauthProfileId" ValueChanged="v => oauthProfileId = v ?? string.Empty" Items="@ProfileItems" />
            <input @bind="oauthName" placeholder="Название подключения (необязательно)" style="max-width:280px" />
        </div>
    }

    @if (showToken)
    {
        <div class="card">
            <div class="head"><h3>Новое подключение по токену</h3></div>
            <div class="form">
                <label class="field">Тип
                    <Dropdown Value="@type.ToString()" ValueChanged="v => { type = Enum.Parse<ConnectorType>(v!); secrets.Clear(); }" Items="@connectors.Select(c => new Dropdown.Item(c.Type.ToString(), c.Label)).ToList()" />
                </label>
                <label class="field">Профиль <Dropdown Value="@profileId" ValueChanged="v => profileId = v ?? string.Empty" Items="@ProfileItems" /></label>
                <label class="field">Название <input @bind="name" placeholder="напр. Брокерский Т-Инвестиции" /></label>
                @foreach (var key in Connector?.RequiredSecrets ?? [])
                {
                    <label class="field">@Label(key)
                        @if (key.Contains("pfx"))
                        {
                            <InputFile OnChange="e => LoadPfx(e, key)" accept=".pfx,.p12" />
                        }
                        else
                        {
                            <input type="@(key.Contains("password") || key.Contains("secret") || key.Contains("token") ? "password" : "text")" value="@secrets.GetValueOrDefault(key)" @onchange="e => secrets[key] = e.Value?.ToString() ?? string.Empty" />
                        }
                    </label>
                }
                <label class="field">Глубина первой загрузки, дней <input type="number" @bind="initialDays" /></label>
                <div><button class="primary" @onclick="Create" disabled="@(busyId is not null || string.IsNullOrWhiteSpace(name) || Connector is null)">Подключить и синхронизировать</button></div>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "connected")] public Guid? ConnectedQ { get; set; }
    [SupplyParameterFromQuery(Name = "oauth")] public string? OAuthQ { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? MsgQ { get; set; }

    IReadOnlyList<ProfileDto>? profiles;
    IReadOnlyList<ConnectionDto> connections = [];
    IReadOnlyList<ConnectorInfoDto> connectors = [];
    List<ConnectorInfoDto> oauth = [];
    ConnectorType type = ConnectorType.TInvest;
    string profileId = "", name = "", oauthProfileId = "", oauthName = "";
    int initialDays = 365;
    bool showToken;
    Dictionary<string, string> secrets = new();
    Guid? busyId; string? msg, msgCss;
    string uid = "";

    ConnectorInfoDto? Connector => connectors.FirstOrDefault(c => c.Type == type);
    List<Dropdown.Item> ProfileItems => (profiles ?? []).Select(p => new Dropdown.Item(p.Id.ToString(), p.Name)).ToList();

    protected override async Task OnInitializedAsync()
    {
        uid = await Me.IdAsync();
        profiles = await Me.ProfilesAsync();
        profileId = oauthProfileId = profiles[0].Id.ToString();
        connectors = Svc.Connectors();
        oauth = connectors.Where(c => c.SupportsOAuth && c.OAuthConfigured).ToList();
        await Reload();

        if (OAuthQ == "error") { msg = "Не удалось подключить: " + MsgQ; msgCss = "err"; }
        else if (ConnectedQ is { } id && connections.FirstOrDefault(x => x.Id == id) is { } c)
        {
            msg = $"Подключение «{c.Name}» создано, запускаю первую синхронизацию…"; msgCss = "ok";
            await Sync(c);
        }
    }

    async Task Reload() => connections = await Svc.ListAsync(uid);

    /// <summary>Веб уходит на страницу банка и вернётся на /connections?connected=…; приложение открывает системный браузер и ждёт появления подключения.</summary>
    async Task StartOAuth(ConnectorInfoDto oc)
    {
        msg = null;
        try
        {
            var before = connections.Select(c => c.Id).ToHashSet();
            await Shell.StartBankOAuthAsync(oc.OAuthProviderKey!, Guid.Parse(oauthProfileId), oauthName.Trim());
            if (Shell.IsBrowserHosted) return;
            msg = $"Открыт браузер: войдите в {oc.ProviderDisplayName} и подтвердите доступ. Жду возврата…"; msgCss = "info";
            var created = await WaitForNewConnectionAsync(before);
            if (created is null) { msg = "Подтверждение из банка не пришло за 5 минут. Попробуйте ещё раз."; msgCss = "warn"; return; }
            msg = $"Подключение «{created.Name}» создано, запускаю первую синхронизацию…"; msgCss = "ok";
            await Sync(created);
        }
        catch (Exception ex) { msg = ex.Message; msgCss = "err"; }
    }

    async Task<ConnectionDto?> WaitForNewConnectionAsync(HashSet<Guid> before)
    {
        for (var i = 0; i < 100; i++)
        {
            await Task.Delay(3000);
            await Reload();
            StateHasChanged();
            if (connections.FirstOrDefault(c => !before.Contains(c.Id) && !c.IsStatementImport) is { } fresh) return fresh;
        }
        return null;
    }

    async Task LoadPfx(InputFileChangeEventArgs e, string key)
    {
        using var ms = new MemoryStream();
        await e.File.OpenReadStream(1024 * 1024).CopyToAsync(ms);
        secrets[key] = Convert.ToBase64String(ms.ToArray());
    }

    async Task Create()
    {
        msg = null;
        try
        {
            var c = await Svc.CreateAsync(uid, Guid.Parse(profileId), type, name.Trim(), secrets);
            secrets.Clear(); name = ""; showToken = false;
            await Reload();
            await Sync(c);
        }
        catch (Exception ex) { msg = ex.Message; msgCss = "err"; }
    }

    async Task Sync(ConnectionDto c)
    {
        busyId = c.Id;
        try
        {
            var run = await Svc.SyncAsync(uid, c.Id, initialDays);
            msg = run.Error is null ? $"«{c.Name}»: новых операций {run.Imported}, дубликатов {run.Skipped}" : $"«{c.Name}»: ошибка — {run.Error}";
            msgCss = run.Error is null ? "ok" : "err";
        }
        catch (Exception ex) { msg = ex.Message; msgCss = "err"; }
        busyId = null;
        await Reload();
    }

    async Task Delete(ConnectionDto c) { await Svc.DeleteAsync(uid, c.Id); await Reload(); }

    static string TypeLabel(ConnectorType t) => CashFlow.Application.Connections.ConnectionsService.Label(t);
    static string Status(ConnectionStatus s) => s switch { ConnectionStatus.Active => "активно", ConnectionStatus.NeedsReauth => "нужен вход", ConnectionStatus.Error => "ошибка", ConnectionStatus.Disabled => "выключено", _ => s.ToString() };
    static string Glyph(ConnectionDto c) => c.Type switch { ConnectorType.StatementImport => "⇪", ConnectorType.SberBusiness => "С", ConnectorType.TBankBusiness or ConnectorType.TInvest => "Т", ConnectorType.AlfaBusiness => "А", _ => "⟳" };

    static string Label(string key) => key switch
    {
        "token" => "API-токен (только чтение)", "client_id" => "Client ID", "client_secret" => "Client Secret", "refresh_token" => "Refresh token",
        "cert_pfx_base64" => "Клиентский сертификат (.pfx)", "cert_password" => "Пароль сертификата", _ => key
    };
}
