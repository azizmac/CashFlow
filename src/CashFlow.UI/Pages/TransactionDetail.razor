@page "/transactions/{Id:guid}"
@attribute [Authorize]
@inject ICurrentUser Me
@inject ILedgerQueries Q
@inject ILedgerCommands Commands

<PageTitle>Операция — CashFlow</PageTitle>

@if (d is null) { @if (loaded) { <div class="card empty"><div class="icon">?</div><div class="ttl">Операция не найдена</div><p>Возможно, она удалена вместе со счётом. <a href="/transactions">К списку операций</a></p></div> } else { <Skeleton Rows="3" Hero="110" Title="false" /> } return; }

<div class="crumbs"><a href="/transactions">Операции</a> › <a href="/transactions?account=@d.Transaction.AccountId&transfers=1">@d.Transaction.AccountName</a> › @d.Transaction.PostedAt.Local().ToString("dd.MM.yyyy")</div>

<div class="stack">
    <div class="card hero detail-head">
        <div class="row" style="align-items:flex-start;gap:14px">
            <div class="icon lg" style="background:@(d.Transaction.IsTransfer ? "var(--icon-bg)" : Ui.CategoryTint(Cat?.Color, 0))">@(d.Transaction.IsTransfer ? "⇄" : Cat?.Icon ?? "?")</div>
            <div class="grow">
                <div class="amount num @(d.Transaction.IsTransfer ? "" : d.Transaction.IsIncome ? "pos" : "neg")">@(d.Transaction.IsIncome ? "+" : "−")@Ui.N2(Math.Abs(d.Transaction.Amount)) @d.Transaction.Currency</div>
                <div style="font-size:17px;font-weight:640;margin-top:4px">@d.Transaction.Description</div>
                <div class="muted" style="font-size:12.5px;margin-top:4px">
                    @d.Transaction.PostedAt.Local().ToString("d MMMM yyyy, HH:mm", Ru)
                    @if (d.Transaction.BookedAt is { } b && b.Date != d.Transaction.PostedAt.Date) { <span> · проведено @b.Local().ToString("dd.MM.yyyy")</span> }
                </div>
                <div class="wrap" style="margin-top:8px">
                    @if (d.Transaction.IsTransfer) { <span class="pill">перевод между своими счетами</span> }
                    @if (d.Transaction.Status == TransactionStatus.Pending) { <span class="pill warn">в обработке</span> }
                    @if (d.Transaction.Status == TransactionStatus.Cancelled) { <span class="pill err">отменена</span> }
                    @if (d.Transaction.Mcc is not null) { <span class="pill">MCC @d.Transaction.Mcc</span> }
                    @foreach (var t in d.Transaction.Tags) { <span class="pill accent">#@t</span> }
                </div>
            </div>
        </div>
    </div>

    @if (msg is not null) { <div class="alert ok">@msg</div> }

    <div class="grid2">
        <div class="stack">
            <div class="card">
                <div class="head"><h3>Категория</h3>
                    @if (d.Transaction.CategoryId is not null) { <span class="muted" style="font-size:12px">@Ui.SourceLabel(d.Transaction.CategorySource)@(d.Transaction.CategoryConfidence is { } cf && d.Transaction.CategorySource != CategorySource.User ? $" · {cf:P0}" : "")</span> }
                </div>
                @if (d.Transaction.CategoryId is null && d.Transaction.ProposedCategoryId is not null)
                {
                    <div class="insight" style="margin-bottom:12px;padding:12px 14px" >
                        <div class="row"><div class="grow"><div class="eyebrow">✦ Предложение</div><div style="margin-top:3px">@d.Transaction.ProposedCategoryLabel</div></div><button class="small white" @onclick="Accept">✓ Принять</button></div>
                    </div>
                }
                <Dropdown Class="block" Value="@(d.Transaction.CategoryId?.ToString() ?? "")" ValueChanged="SetCategory" Placeholder="Без категории" Items="@CategoryItems" />
                @if (d.Counterparty is not null)
                {
                    <label class="row" style="margin-top:10px;font-size:13px;color:var(--text-2)"><input type="checkbox" @bind="applyToCounterparty" /> применять ко всем операциям «@d.Counterparty.DisplayName»</label>
                }
            </div>

            <div class="card tight">
                <div class="head" style="padding:16px 18px 6px"><h3>Контрагент</h3></div>
                @if (d.Counterparty is not null)
                {
                    <div class="list">
                    <a class="item clickable" href="/counterparties/@d.Counterparty.Id">
                        <Avatar Name="@d.Counterparty.DisplayName" />
                        <div class="grow">
                            <div class="ttl">@d.Counterparty.DisplayName</div>
                            <div class="sub">@Ui.KindLabel(d.Counterparty.Kind)@(d.Counterparty.Inn is not null ? $" · ИНН {d.Counterparty.Inn}" : "")@(d.Counterparty.Kpp is not null ? $" / КПП {d.Counterparty.Kpp}" : "")</div>
                            @if (d.Counterparty.AccountsMasked.Count > 0 || d.Counterparty.PhonesMasked.Count > 0) { <div class="sub">@string.Join(", ", d.Counterparty.AccountsMasked.Concat(d.Counterparty.PhonesMasked))</div> }
                        </div>
                        <Icon Name="chevron" Size="14" Class="chev" />
                    </a>
                    </div>
                }
                else { <p class="muted" style="padding:0 18px 16px;margin:0">Контрагент не определён.</p> }
                @if (!d.Raw.IsEmpty)
                {
                    <details style="padding:4px 18px 12px">
                        <summary class="muted" style="font-size:12.5px">Реквизиты из выписки</summary>
                        <div class="stack-sm" style="gap:4px;margin-top:6px;font-size:13px">
                            @if (d.Raw.Name is not null) { <div class="kv-line"><span>Название</span><span>@d.Raw.Name</span></div> }
                            @if (d.Raw.Inn is not null) { <div class="kv-line"><span>ИНН</span><span>@d.Raw.Inn</span></div> }
                            @if (d.Raw.AccountMasked is not null) { <div class="kv-line"><span>Счёт</span><span>@d.Raw.AccountMasked</span></div> }
                            @if (d.Raw.Bik is not null) { <div class="kv-line"><span>Банк</span><span>@d.Raw.Bik @d.Raw.BankName</span></div> }
                            @if (d.Raw.PhoneMasked is not null) { <div class="kv-line"><span>Телефон</span><span>@d.Raw.PhoneMasked</span></div> }
                        </div>
                    </details>
                }
            </div>

            <div class="card">
                <div class="head"><h3>Заметка и теги</h3></div>
                <div class="form">
                    <textarea rows="2" @bind="note" placeholder="Заметка"></textarea>
                    <div class="row"><input class="grow" @bind="tags" placeholder="Теги через запятую: налоги, аренда" /><button class="small primary" @onclick="SaveNote">Сохранить</button></div>
                </div>
            </div>
        </div>

        <div class="stack">
            <div class="card">
                <div class="head"><h3>Детали</h3></div>
                <div class="stack-sm" style="gap:8px">
                    <div class="kv-line"><span>Счёт</span><a href="/transactions?account=@d.Transaction.AccountId&transfers=1">@d.Transaction.AccountName <span class="muted">@d.AccountNumberMasked</span></a></div>
                    <div class="kv-line"><span>Профиль · банк</span><span>@d.ProfileName · @d.BankName</span></div>
                    @if (!string.IsNullOrWhiteSpace(d.Transaction.Purpose) && d.Transaction.Purpose != d.Transaction.Description) { <div><div class="eyebrow" style="margin-bottom:3px">Назначение платежа</div><div style="font-size:13.5px;line-height:1.45">@d.Transaction.Purpose</div></div> }
                    @if (d.Pair is not null)
                    {
                        <div class="kv-line"><span>Парная операция</span><a href="/transactions/@d.Pair.Id">@d.Pair.AccountName: @(d.Pair.IsIncome ? "+" : "−")@Ui.N2(Math.Abs(d.Pair.Amount)) · @d.Pair.PostedAt.Local().ToString("dd.MM.yyyy")</a></div>
                    }
                </div>
            </div>

            <div class="card">
                <div class="head"><h3>Откуда эти данные</h3></div>
                <div class="stack-sm" style="gap:8px">
                    <div class="kv-line"><span>Источник</span><span>@SourceLabel(d.Source.Source)</span></div>
                    @if (d.Source.ConnectionName is not null) { <div class="kv-line"><span>Подключение</span><a href="/connections">@d.Source.ConnectionName@(d.Source.SourceCode is not null ? $" · {d.Source.SourceCode}" : "")</a></div> }
                    @if (d.Source.FileName is not null) { <div class="kv-line"><span>Файл</span><span style="word-break:break-all;text-align:right">@d.Source.FileName</span></div> }
                    @if (d.Source.LoadedAt is { } la) { <div class="kv-line"><span>Загружено</span><span>@la.Local().ToString("dd.MM.yyyy HH:mm")</span></div> }
                    @if (d.Source.ExternalId is not null) { <div class="kv-line"><span>Внешний ID</span><span class="muted" style="font-weight:400;word-break:break-all;text-align:right">@d.Source.ExternalId</span></div> }
                    <div class="kv-line"><span>Импортировано</span><span class="muted" style="font-weight:400">@d.Source.ImportedAt.Local().ToString("dd.MM.yyyy HH:mm")</span></div>
                </div>
                @if (d.Source.RawPayload is not null)
                {
                    <details style="margin-top:8px"><summary class="muted" style="font-size:12.5px">Сырая запись из выписки</summary><pre class="raw">@d.Source.RawPayload</pre></details>
                }
            </div>

            @if (d.Similar.Count > 0)
            {
                <div class="card tight">
                    <div class="head" style="padding:16px 18px 6px"><h3>Похожие операции</h3></div>
                    <div class="list">
                        @foreach (var r in d.Similar)
                        {
                            <a class="item clickable" href="/transactions/@r.Id">
                                <div class="grow"><div class="ttl">@r.Description</div><div class="sub">@r.PostedAt.Local().ToString("d MMM yyyy", Ru) · @(r.CategoryLabel ?? "без категории")</div></div>
                                <div class="amt num @(r.IsIncome ? "pos" : "")">@(r.IsIncome ? "+" : "−")@Ui.N0(Math.Abs(r.Amount))</div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    static readonly System.Globalization.CultureInfo Ru = System.Globalization.CultureInfo.GetCultureInfo("ru-RU");

    TransactionDetailDto? d;
    IReadOnlyList<CategoryDto> categories = [];
    bool loaded, applyToCounterparty;
    string uid = "", note = "", tags = "";
    string? msg;

    CategoryDto? Cat => d?.Transaction.CategoryId is { } c ? categories.FirstOrDefault(x => x.Id == c) : null;
    List<Dropdown.Item> CategoryItems => d is null ? [] : new List<Dropdown.Item> { new("", "Без категории") }
        .Concat(categories.Where(c => c.Id == d.Transaction.CategoryId || c.Kind == (d.Transaction.IsIncome ? CategoryKind.Income : CategoryKind.Expense) || c.Kind == CategoryKind.Transfer || c.Kind == CategoryKind.Investment)
            .OrderBy(c => c.Kind).Select(c => new Dropdown.Item(c.Id.ToString(), c.Name, c.Icon, c.Kind switch { CategoryKind.Income => "Доходы", CategoryKind.Expense => "Расходы", CategoryKind.Transfer => "Переводы", _ => "Инвестиции" }))).ToList();

    protected override async Task OnParametersSetAsync()
    {
        uid = await Me.IdAsync();
        categories = await Q.CategoriesAsync(uid);
        await Load();
    }

    async Task Load()
    {
        d = await Q.TransactionAsync(uid, Id);
        loaded = true;
        if (d is not null) { note = d.Transaction.Note ?? ""; tags = string.Join(", ", d.Transaction.Tags); }
    }

    async Task SetCategory(string? value)
    {
        Guid? cat = Guid.TryParse(value, out var g) ? g : null;
        await Commands.SetCategoryAsync(uid, Id, cat, applyToCounterparty);
        msg = applyToCounterparty && cat is not null ? "Категория сохранена и применена к операциям контрагента." : "Категория сохранена.";
        await Load();
    }

    async Task Accept() { await Commands.AcceptProposalAsync(uid, Id); await Load(); }

    async Task SaveNote()
    {
        await Commands.SetNoteAsync(uid, Id, note, tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        msg = "Заметка сохранена.";
        await Load();
    }

    static string SourceLabel(ConnectorType t) => t switch
    {
        ConnectorType.StatementImport => "файл выписки", ConnectorType.Manual => "введено вручную", ConnectorType.TInvest => "T-Invest API",
        ConnectorType.TBankBusiness => "T-API (Т-Бизнес)", ConnectorType.SberBusiness => "Sber API", ConnectorType.AlfaBusiness => "Alfa API", _ => t.ToString()
    };
}
