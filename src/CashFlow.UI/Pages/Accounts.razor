@page "/accounts"
@attribute [Authorize]
@inject ICurrentUser Me
@inject ILedgerQueries Q
@inject ILedgerCommands Commands

<PageTitle>Счета — CashFlow</PageTitle>

<PageHead Eyebrow="Accounts" Title="Счета и банки">
    <Tools><button class="small" @onclick="() => showAdd = !showAdd">@(showAdd ? "Скрыть" : "+ Ручной счёт")</button></Tools>
</PageHead>

@if (profiles is null) { <p class="muted">Загрузка…</p> return; }

<div class="stack">
    <div class="card hero">
        <div class="eyebrow">Net worth</div>
        <div class="big-number num">@Ui.Rub(NetWorth)</div>
        <div class="muted" style="font-size:12.5px">@accounts.Count(a => a.IncludeInNetWorth) @Home.Plural(accounts.Count(a => a.IncludeInNetWorth), "счёт", "счёта", "счетов") в активах</div>
        @if (byType.Count > 0)
        {
            <div class="bar-stack">
                @foreach (var t in byType) { <div style="flex:@((double)t.Sum);background:@t.Color" title="@t.Label"></div> }
            </div>
            <div class="legend">
                @foreach (var t in byType) { <span><span class="dot" style="background:@t.Color"></span>@t.Label · @Ui.N0(t.Sum)</span> }
            </div>
        }
    </div>

    @if (accounts.Count == 0)
    {
        <div class="insight"><div class="eyebrow">Начало</div><p>Счетов пока нет — <a href="/sources">загрузите первую выписку</a>, счёт создастся автоматически.</p></div>
    }

    @foreach (var bank in accounts.GroupBy(a => a.BankName))
    {
        <div class="card tight">
            <div class="section row"><span class="grow">@bank.Key</span><span class="num" style="text-transform:none;letter-spacing:0">@Ui.N0(bank.Sum(a => a.Balance ?? 0)) ₽</span></div>
            <div class="list">
                @foreach (var a in bank)
                {
                    <div class="item @(a.IncludeInNetWorth ? "" : "dim")">
                        <a class="icon plain" href="/transactions?account=@a.Id&transfers=1">@Glyph(a.Type)</a>
                        <a class="grow plain" href="/transactions?account=@a.Id&transfers=1">
                            <div class="ttl">@a.Name</div>
                            <div class="sub">@Ui.AccountTypeLabel(a.Type) · @a.ProfileName@(a.NumberMasked is not null ? $" · {a.NumberMasked}" : "")@(a.BalanceAt is { } bt ? $" · остаток на {bt.Local():dd.MM.yy}" : "")</div>
                        </a>
                        <div class="right">
                            <div class="amt num">@(a.Balance is { } b ? $"{Ui.N0(b)} {a.Currency}" : "—")</div>
                            <div class="sub" style="display:flex;gap:8px;justify-content:flex-end;margin-top:3px">
                                <label title="Учитывать в денежном потоке"><input type="checkbox" checked="@a.IncludeInCashFlow" @onchange="e => Flags(a, cashFlow: (bool)e.Value!)" /> поток</label>
                                <label title="Учитывать в чистых активах"><input type="checkbox" checked="@a.IncludeInNetWorth" @onchange="e => Flags(a, netWorth: (bool)e.Value!)" /> активы</label>
                                <button class="link muted" @onclick="() => Archive(a)" title="В архив">✕</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (showAdd)
    {
        <div class="card">
            <div class="head"><h3>Ручной счёт</h3><span class="muted" style="font-size:12px">наличные, кошелёк, вклад без выписки</span></div>
            <div class="form">
                <label class="field">Название <input @bind="newName" /></label>
                <label class="field">Профиль <select @bind="newProfile">@foreach (var p in profiles) { <option value="@p.Id">@p.Name</option> }</select></label>
                <label class="field">Тип <select @bind="newType">@foreach (var t in Enum.GetValues<AccountType>()) { <option value="@t">@Ui.AccountTypeLabel(t)</option> }</select></label>
                <div class="row">
                    <label class="field grow">Валюта <input @bind="newCurrency" maxlength="3" /></label>
                    <label class="field grow">Текущий остаток <input type="number" step="0.01" @bind="newBalance" /></label>
                </div>
                <div><button class="primary" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(newName)">Добавить</button></div>
                @if (err is not null) { <div class="alert err">@err</div> }
            </div>
        </div>
    }
</div>

@code {
    IReadOnlyList<ProfileDto>? profiles;
    IReadOnlyList<AccountDto> accounts = [];
    List<(string Label, decimal Sum, string Color)> byType = [];
    string uid = "";
    bool showAdd;
    string newName = "", newProfile = "", newCurrency = "RUB"; AccountType newType = AccountType.Cash; decimal newBalance;
    string? err;

    decimal NetWorth => accounts.Where(a => a.IncludeInNetWorth).Sum(a => a.Balance ?? 0);

    protected override async Task OnInitializedAsync()
    {
        uid = await Me.IdAsync();
        profiles = await Me.ProfilesAsync();
        newProfile = profiles[0].Id.ToString();
        await Reload();
    }

    async Task Reload()
    {
        accounts = await Q.AccountsAsync(uid);
        string[] colors = ["oklch(.7 .15 250)", "oklch(.72 .14 150)", "oklch(.7 .12 300)", "oklch(.75 .13 70)", "oklch(.68 .06 240)", "oklch(.7 .12 200)"];
        byType = accounts.Where(a => a.IncludeInNetWorth && (a.Balance ?? 0) > 0).GroupBy(a => Ui.AccountTypeLabel(a.Type))
            .Select((g, i) => (g.Key, g.Sum(a => a.Balance ?? 0), colors[i % colors.Length])).OrderByDescending(x => x.Item2).ToList();
    }

    async Task Flags(AccountDto a, bool? cashFlow = null, bool? netWorth = null)
    {
        await Commands.SetAccountFlagsAsync(uid, a.Id, cashFlow ?? a.IncludeInCashFlow, netWorth ?? a.IncludeInNetWorth);
        await Reload();
    }

    async Task Archive(AccountDto a) { await Commands.ArchiveAccountAsync(uid, a.Id); await Reload(); }

    async Task Add()
    {
        err = null;
        try
        {
            await Commands.CreateManualAccountAsync(uid, Guid.Parse(newProfile), newType, newName, newCurrency, newBalance);
            newName = ""; newBalance = 0; showAdd = false;
            await Reload();
        }
        catch (Exception ex) { err = ex.Message; }
    }

    static string Glyph(AccountType t) => t switch
    {
        AccountType.Card or AccountType.CreditCard => "▭", AccountType.Checking => "◫", AccountType.Savings or AccountType.Deposit => "◔",
        AccountType.Brokerage or AccountType.Iis => "◈", AccountType.Cash => "₽", AccountType.EWallet => "◎", AccountType.Loan => "◒", _ => "•"
    };

    public static string Type(AccountType t) => Ui.AccountTypeLabel(t);
}
