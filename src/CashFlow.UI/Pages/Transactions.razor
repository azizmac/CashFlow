@page "/transactions"
@attribute [Authorize]
@inject ICurrentUser Me
@inject ILedgerQueries Q
@inject ILedgerCommands Commands

<PageTitle>Операции — CashFlow</PageTitle>
<h1>Операции</h1>

@if (profiles is null) { <p class="muted">Загрузка…</p> return; }

<div class="toolbar">
    <select @bind="profileId" @bind:after="Reload"><option value="">Все профили</option>@foreach (var p in profiles) { <option value="@p.Id">@p.Name</option> }</select>
    <select @bind="accountId" @bind:after="Reload"><option value="">Все счета</option>@foreach (var a in accounts) { <option value="@a.Id">@a.Name</option> }</select>
    <select @bind="categoryId" @bind:after="Reload"><option value="">Все категории</option>@foreach (var c in categories) { <option value="@c.Id">@c.Label</option> }</select>
    <input type="date" @bind="from" @bind:after="Reload" />
    <input type="date" @bind="to" @bind:after="Reload" />
    <input placeholder="Поиск по описанию / контрагенту" @bind="search" @bind:after="Reload" style="min-width:240px" />
    <label><input type="checkbox" @bind="onlyUncategorized" @bind:after="Reload" /> только без категории</label>
    <label><input type="checkbox" @bind="includeTransfers" @bind:after="Reload" /> показывать переводы</label>
</div>

@if (cp is not null) { <div class="alert info">Фильтр по контрагенту: <b>@cp.DisplayName</b> <a href="/transactions">сбросить</a></div> }

<p class="muted">@rows.Count операций · доходы +@rows.Where(r => r.IsIncome).Sum(r => r.Amount).ToString("N0") · расходы −@rows.Where(r => r.IsExpense).Sum(r => -r.Amount).ToString("N0")</p>

<table>
    <thead><tr><th>Дата</th><th>Кто / кому</th><th>Описание</th><th>Категория</th><th>Счёт</th><th class="num">Сумма</th></tr></thead>
    <tbody>
    @foreach (var r in rows)
    {
        <tr>
            <td style="white-space:nowrap"><a href="/transactions/@r.Id" title="Открыть операцию">@r.PostedAt.Local().ToString("dd.MM.yy HH:mm")</a></td>
            <td>
                @if (r.CounterpartyId is { } cid) { <a href="/transactions?cp=@cid">@r.CounterpartyName</a> }
                else { <span class="muted">—</span> }
                @if (r.IsTransfer) { <span class="pill">перевод</span> }
                @if (r.Status == TransactionStatus.Pending) { <span class="pill warn">в обработке</span> }
            </td>
            <td>
                <div><a href="/transactions/@r.Id" class="plain">@r.Description</a></div>
                @if (!string.IsNullOrEmpty(r.Purpose) && r.Purpose != r.Description) { <div class="muted" style="font-size:12px">@r.Purpose</div> }
                @if (r.Mcc is not null) { <span class="muted" style="font-size:11px">MCC @r.Mcc</span> }
            </td>
            <td>
                <select value="@(r.CategoryId?.ToString() ?? "")" @onchange="e => SetCategory(r, e.Value?.ToString())" style="max-width:200px">
                    <option value="">— без категории —</option>
                    @foreach (var c in categories.Where(c => c.Kind == (r.IsIncome ? CategoryKind.Income : CategoryKind.Expense) || c.Kind == CategoryKind.Transfer || c.Kind == CategoryKind.Investment))
                    { <option value="@c.Id">@c.Label</option> }
                </select>
                @if (r.CategoryId is null && r.ProposedCategoryId is not null)
                {
                    <div style="font-size:12px">предложено: @r.ProposedCategoryLabel <button class="small" @onclick="() => Accept(r)">✓</button></div>
                }
                else if (r.CategoryId is not null)
                {
                    <div class="muted" style="font-size:11px">@Src(r.CategorySource)</div>
                }
            </td>
            <td class="muted">@r.AccountName</td>
            <td class="num @(r.IsIncome ? "pos" : "neg")">@(r.IsIncome ? "+" : "")@r.Amount.ToString("N2") @r.Currency</td>
        </tr>
    }
    </tbody>
</table>

@code {
    [SupplyParameterFromQuery(Name = "cp")] public Guid? CpId { get; set; }
    [SupplyParameterFromQuery(Name = "uncategorized")] public int? Uncat { get; set; }
    [SupplyParameterFromQuery(Name = "account")] public Guid? AccountQ { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? FromQ { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? ToQ { get; set; }
    [SupplyParameterFromQuery(Name = "transfers")] public int? TransfersQ { get; set; }

    IReadOnlyList<ProfileDto>? profiles;
    IReadOnlyList<AccountDto> accounts = [];
    IReadOnlyList<CategoryDto> categories = [];
    IReadOnlyList<TransactionDto> rows = [];
    CounterpartyDto? cp;
    string? profileId, accountId, categoryId, search;
    DateOnly from = DateOnly.FromDateTime(DateTime.Today).AddMonths(-3), to = DateOnly.FromDateTime(DateTime.Today);
    bool onlyUncategorized, includeTransfers;
    string uid = "";

    protected override async Task OnInitializedAsync()
    {
        uid = await Me.IdAsync();
        profiles = await Me.ProfilesAsync();
        accounts = await Q.AccountsAsync(uid);
        categories = await Q.CategoriesAsync(uid);
        onlyUncategorized = Uncat == 1;
        includeTransfers = TransfersQ == 1;
        if (AccountQ is { } aq) { accountId = aq.ToString(); from = from.AddMonths(-9); }
        if (DateOnly.TryParse(FromQ, out var fq)) from = fq;
        if (DateOnly.TryParse(ToQ, out var tq)) to = tq;
        if (CpId is { } id) { cp = await Q.CounterpartyAsync(uid, id); from = from.AddMonths(-9); }
        await Reload();
    }

    async Task Reload()
    {
        var f = new TransactionFilter(G(profileId), G(accountId), G(categoryId), CpId, from, to, search, onlyUncategorized, includeTransfers);
        rows = await Q.TransactionsAsync(uid, f);
    }

    static Guid? G(string? s) => Guid.TryParse(s, out var g) ? g : null;

    async Task SetCategory(TransactionDto r, string? value)
    {
        await Commands.SetCategoryAsync(uid, r.Id, Guid.TryParse(value, out var g) ? g : null, applyToCounterparty: false);
        await Reload();
    }

    async Task Accept(TransactionDto r) { await Commands.AcceptProposalAsync(uid, r.Id); await Reload(); }

    static string Src(CategorySource s) => s switch { CategorySource.User => "вручную", CategorySource.Rule => "правило", CategorySource.Mcc => "по MCC", CategorySource.Ai => "ИИ", CategorySource.Counterparty => "по контрагенту", _ => "" };
}
