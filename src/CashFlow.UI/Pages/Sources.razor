@page "/sources"
@page "/import"
@attribute [Authorize]
@inject ICurrentUser Me
@inject ILedgerQueries Q
@inject IConnectionsService Connections
@inject IImportService Importer
@inject IAppShell Shell

<PageTitle>Источники данных — CashFlow</PageTitle>
<h1>Источники данных</h1>
<p class="muted">Одно место, чтобы понять, по каким счетам данные свежие, а куда пора догрузить выписку. Файлы обрабатываются на вашем сервере; повторная загрузка того же периода безопасна — операции дедуплицируются.</p>

@if (profiles is null) { <p class="muted">Загрузка…</p> return; }

@* ---------- Загрузка ---------- *@
<div class="upload-panel">
    <div class="toolbar">
        <label>Профиль <select @bind="profileId">@foreach (var p in profiles) { <option value="@p.Id">@p.Name (@Kind(p.Kind))</option> }</select></label>
        <label>Банк <select @bind="bank"><option value="">определить по файлу</option>@foreach (var f in Importer.Formats.DistinctBy(f => f.BankCode)) { <option value="@f.BankCode">@f.DisplayName</option> }</select></label>
    </div>
    <label class="dropzone">
        <InputFile OnChange="OnFiles" multiple accept=".pdf,.xlsx,.csv,.txt" />
        <div class="dz-title">Перетащите выписки сюда или нажмите, чтобы выбрать</div>
        <div class="muted">PDF, XLSX, CSV, TXT (1С) · Сбер, СберБизнес, Т-Банк, любой банк с экспортом в 1С · до 20 файлов за раз</div>
        @if (files.Count > 0) { <div class="dz-files">@string.Join(", ", files.Select(f => f.Name))</div> }
    </label>
    <button class="primary" @onclick="Run" disabled="@(files.Count == 0 || busy)">@(busy ? $"Импортирую… {done}/{files.Count}" : files.Count == 0 ? "Импортировать" : $"Импортировать ({files.Count})")</button>
</div>

@foreach (var m in messages)
{
    <div class="alert @m.Css">@((MarkupString)m.Text)</div>
}

@* ---------- Покрытие ---------- *@
<h2>Покрытие данными по счетам</h2>
@if (coverage.Count == 0)
{
    <div class="alert info">Счетов пока нет — загрузите первую выписку выше, счёт создастся автоматически.</div>
}
else
{
    <div class="cards cover">
    @foreach (var c in coverage)
    {
        <div class="card @(c.IsStale ? "stale" : "")">
            <div class="label">@c.Account.ProfileName · @c.Account.BankName · @Accounts.Type(c.Account.Type)</div>
            <div class="title"><a href="/transactions?account=@c.Account.Id&transfers=1">@c.Account.Name</a> <span class="muted">@c.Account.NumberMasked</span></div>
            @if (c.Count == 0)
            {
                <div class="pill err">операций нет</div>
            }
            else
            {
                <div>операции с <b>@c.First?.ToString("dd.MM.yyyy")</b> по <b>@c.Last?.ToString("dd.MM.yyyy")</b> · @c.Count шт.</div>
                @if (c.StaleDays > 30) { <div class="pill warn">последняя операция @c.StaleDays дн. назад</div> }
                else { <div class="pill ok">свежие данные</div> }
            }
            @if (c.Account.Balance is { } bal) { <div class="muted">остаток @bal.ToString("N2") @c.Account.Currency на @c.Account.BalanceAt?.Local().ToString("dd.MM.yyyy")</div> }
            <div class="muted" style="font-size:12px">источники: @(c.Sources.Count == 0 ? "—" : string.Join("; ", c.Sources))@(c.LastImportAt is { } li ? $" · загружено {li.Local():dd.MM.yyyy HH:mm}" : "")</div>
            @if (c.IsStale && c.Last is { } last)
            {
                <div class="hint">Догрузите выписку за период с @last.AddDays(1).ToString("dd.MM.yyyy") по сегодня — @HowTo(c.Account)</div>
            }
        </div>
    }
    </div>
}

@* ---------- Автоматические подключения ---------- *@
<h2>Автоматические подключения</h2>
@if (connections.Count == 0)
{
    <p class="muted">Пока нет подключений по API.</p>
}
else
{
    <table>
        <thead><tr><th>Подключение</th><th>Статус</th><th>Последняя синхронизация</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in connections)
        {
            <tr>
                <td>@c.Name<div class="muted" style="font-size:11px">@c.ProfileName</div></td>
                <td><span class="pill @(c.Status == ConnectionStatus.Active ? "ok" : "err")">@c.Status</span>@if (c.LastError is not null) { <div class="muted" style="font-size:11px;max-width:320px">@c.LastError</div> }</td>
                <td class="muted">@(c.LastSyncAt?.Local().ToString("dd.MM.yy HH:mm") ?? "—")</td>
                <td><button class="small primary" @onclick="() => Sync(c)" disabled="@(busyId == c.Id)">@(busyId == c.Id ? "…" : "Синхронизировать")</button></td>
            </tr>
        }
        </tbody>
    </table>
}
<p>
    @foreach (var oc in oauth)
    {
        <button class="primary" @onclick="() => StartOAuth(oc)">Подключить через @oc.ProviderDisplayName</button>
    }
    <a href="/connections">Подключение по токену (T-Invest, T-API, Sber API)…</a>
</p>

@* ---------- Как выгрузить ---------- *@
<h2>Как выгрузить выписку из банка</h2>
<details open="@NoAccounts">
    <summary>СберБизнес (р/с ИП или ООО) — лучший вариант: экспорт в 1С</summary>
    <ol class="steps">
        <li>СберБизнес → Счета и платежи → Выписки → выберите счёт и период.</li>
        <li>Кнопка «Экспорт» → формат <b>1С</b> (файл <code>kl_to_1c.txt</code>) — в нём есть контрагенты, ИНН и назначение платежа.</li>
        <li>Подойдёт и раздел <b>Операции → Экспорт в XLSX</b> (файл «СберБизнес_Операции_за_…xlsx»): есть контрагенты и назначение, нет ИНН и остатков.</li>
        <li>«Выписка операций по лицевому счёту» в XLSX/PDF читается тоже, но там нет названий контрагентов — они появятся как «Организация (поступление) · 0123». Загрузите поверх 1С или экспорт операций за тот же период: дублей не будет, операции и контрагенты дополнятся.</li>
    </ol>
</details>
<details>
    <summary>Сбер, карта физлица — PDF из СберБанк Онлайн</summary>
    <ol class="steps">
        <li>СберБанк Онлайн → счёт карты → «Выписки и справки» → «Выписка по счёту дебетовой карты».</li>
        <li>Выберите период (можно год) и получите PDF — загрузите его сюда.</li>
    </ol>
</details>
<details>
    <summary>Т-Банк, карта физлица — XLSX/CSV из личного кабинета</summary>
    <ol class="steps">
        <li>tbank.ru → Операции → фильтр по периоду → «Выгрузить операции» → XLSX или CSV.</li>
    </ol>
</details>
<details>
    <summary>Т-Бизнес, Альфа, ВТБ и другие р/с — экспорт в 1С</summary>
    <ol class="steps">
        <li>В интернет-банке откройте выписку по счёту и выберите экспорт в 1С (1CClientBankExchange, txt). Банк определится по содержимому файла.</li>
        <li>Для Т-Бизнеса можно вместо файлов подключить T-API по токену — данные будут обновляться сами.</li>
    </ol>
</details>

@code {
    IReadOnlyList<ProfileDto>? profiles;
    IReadOnlyList<AccountCoverageDto> coverage = [];
    IReadOnlyList<ConnectionDto> connections = [];
    List<ConnectorInfoDto> oauth = [];
    List<IBrowserFile> files = [];
    List<(string Css, string Text)> messages = [];
    string profileId = "", bank = "", uid = "";
    bool busy; int done; Guid? busyId;
    bool NoAccounts => coverage.Count == 0;

    protected override async Task OnInitializedAsync()
    {
        uid = await Me.IdAsync();
        profiles = await Me.ProfilesAsync();
        profileId = profiles[0].Id.ToString();
        oauth = Connections.Connectors().Where(c => c.SupportsOAuth && c.OAuthConfigured).ToList();
        await Reload();
    }

    async Task Reload()
    {
        coverage = await Q.CoverageAsync(uid);
        connections = (await Connections.ListAsync(uid)).Where(c => !c.IsStatementImport && c.Status != ConnectionStatus.Disabled).ToList();
    }

    void OnFiles(InputFileChangeEventArgs e) => files = e.GetMultipleFiles(20).ToList();

    Task StartOAuth(ConnectorInfoDto oc) => Shell.StartBankOAuthAsync(oc.OAuthProviderKey!, Guid.Parse(profileId), null);

    static string H(string? s) => System.Net.WebUtility.HtmlEncode(s ?? "");

    async Task Run()
    {
        busy = true; done = 0; messages.Clear();
        foreach (var f in files)
        {
            try
            {
                await using var s = f.OpenReadStream(50 * 1024 * 1024);
                var r = await Importer.ImportAsync(uid, Guid.Parse(profileId), s, f.Name, string.IsNullOrEmpty(bank) ? null : bank);
                var period = r.PeriodFrom is { } pf && r.PeriodTo is { } pt ? $"{pf:dd.MM.yyyy} — {pt:dd.MM.yyyy}" : "период не определён";
                var link = r.PeriodFrom is { } lf && r.PeriodTo is { } lt ? $"/transactions?account={r.AccountId}&from={lf:yyyy-MM-dd}&to={lt:yyyy-MM-dd}&transfers=1" : $"/transactions?account={r.AccountId}&transfers=1";
                var w = r.Warnings.Count > 0 ? $"<br/><small>{H(r.Warnings[0])}</small>" : "";
                messages.Add((r.Imported > 0 || r.Updated > 0 ? "ok" : "info",
                    $"<b>{H(f.Name)}</b> → счёт «{H(r.AccountName)}», {period}: новых {r.Imported}, обновлено {r.Updated}, дубликатов {r.SkippedDuplicates}, контрагентов +{r.CounterpartiesCreated}, переводов {r.TransfersLinked}, категоризировано {r.Categorized}. " +
                    $"<a href=\"{link}\">Посмотреть операции</a> · подключение «{H(r.ConnectionName)}»{w}"));
            }
            catch (Exception ex)
            {
                messages.Add(("err", $"<b>{H(f.Name)}</b>: {H(ex.Message)}"));
            }
            done++;
            StateHasChanged();
        }
        files.Clear();
        busy = false;
        await Reload();
    }

    async Task Sync(ConnectionDto c)
    {
        busyId = c.Id;
        try
        {
            var run = await Connections.SyncAsync(uid, c.Id, 365);
            messages.Add((run.Error is null ? "ok" : "err", run.Error is null ? $"«{H(c.Name)}»: новых операций {run.Imported}, дубликатов {run.Skipped}" : $"«{H(c.Name)}»: {H(run.Error)}"));
        }
        catch (Exception ex) { messages.Add(("err", H(ex.Message))); }
        busyId = null;
        await Reload();
    }

    static string HowTo(AccountDto a) => (a.BankCode, a.Type) switch
    {
        (Institution.Codes.Sber, AccountType.Card) => "PDF из СберБанк Онлайн (Выписки и справки).",
        (Institution.Codes.Sber, _) => "экспорт в 1С из СберБизнеса (Выписки → Экспорт → 1С).",
        (Institution.Codes.TBank, AccountType.Card) => "«Выгрузить операции» в личном кабинете Т-Банка (XLSX/CSV).",
        (Institution.Codes.TBank, _) => "экспорт в 1С из Т-Бизнеса или подключение T-API по токену.",
        _ => "экспорт в 1С из интернет-банка.",
    };

    static string Kind(ProfileKind k) => k switch { ProfileKind.SoleProprietor => "ИП", ProfileKind.Company => "компания", _ => "физлицо" };
}
