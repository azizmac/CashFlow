<Project Sdk="Microsoft.NET.Sdk">

  <!-- Composition root сервера: всё, что нужно, чтобы поднять API CashFlow (Identity, PostgreSQL, парсеры, коннекторы, планировщик).
       Используется веб-хостом (CashFlow.Web) и настольным приложением (CashFlow.Maui на Windows/macOS запускает сервер внутри себя). -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CashFlow.Application\CashFlow.Application.csproj" />
    <ProjectReference Include="..\CashFlow.Api\CashFlow.Api.csproj" />
    <ProjectReference Include="..\CashFlow.Infrastructure\CashFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\CashFlow.Connectors.Statements\CashFlow.Connectors.Statements.csproj" />
    <ProjectReference Include="..\CashFlow.Connectors.TInvest\CashFlow.Connectors.TInvest.csproj" />
    <ProjectReference Include="..\CashFlow.Connectors.TBank.Business\CashFlow.Connectors.TBank.Business.csproj" />
    <ProjectReference Include="..\CashFlow.Connectors.Sber.Business\CashFlow.Connectors.Sber.Business.csproj" />
    <ProjectReference Include="..\CashFlow.Connectors.Alfa.Business\CashFlow.Connectors.Alfa.Business.csproj" />
  </ItemGroup>

</Project>
