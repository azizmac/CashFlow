@inherits LayoutComponentBase

<div class="shell">
    <aside class="side">
        <div class="brand">💸 CashFlow AI</div>
        <AuthorizeView>
            <Authorized>
                <nav>
                    <NavLink href="/" Match="NavLinkMatch.All">Обзор</NavLink>
                    <NavLink href="/transactions">Операции</NavLink>
                    <NavLink href="/counterparties">Контрагенты</NavLink>
                    <NavLink href="/accounts">Счета</NavLink>
                    <NavLink href="/import">Импорт выписки</NavLink>
                    <NavLink href="/connections">Подключения</NavLink>
                    <NavLink href="/categories">Категории</NavLink>
                    <NavLink href="/profiles">Профили</NavLink>
                </nav>
                <div class="user">
                    <span>@context.User.Identity?.Name</span>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="/" />
                        <button type="submit" class="link">Выйти</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <nav>
                    <NavLink href="Account/Login">Войти</NavLink>
                    <NavLink href="Account/Register">Регистрация</NavLink>
                </nav>
            </NotAuthorized>
        </AuthorizeView>
        <div class="foot">только чтение · данные не покидают ваш сервер</div>
    </aside>
    <main class="main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>
