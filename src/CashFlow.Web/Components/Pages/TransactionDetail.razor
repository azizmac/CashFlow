@page "/transactions/{Id:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject ILedgerQueries Q
@inject ILedgerCommands Commands
@using CashFlow.Application
@using CashFlow.Application.Contracts

<PageTitle>Операция — CashFlow</PageTitle>

@if (d is null) { <p class="muted">@(loaded ? "Операция не найдена." : "Загрузка…")</p> return; }

<div class="crumbs"><a href="/transactions">Операции</a> › <a href="/transactions?account=@d.Transaction.AccountId">@d.Transaction.AccountName</a> › @d.Transaction.PostedAt.Local().ToString("dd.MM.yyyy")</div>

<div class="detail-head">
    <div>
        <div class="amount @(d.Transaction.IsIncome ? "pos" : "neg")">@(d.Transaction.IsIncome ? "+" : "−")@Math.Abs(d.Transaction.Amount).ToString("N2") @d.Transaction.Currency</div>
        <h1 style="margin:4px 0">@d.Transaction.Description</h1>
        <div class="muted">
            @d.Transaction.PostedAt.Local().ToString("dd.MM.yyyy HH:mm")
            @if (d.Transaction.BookedAt is { } b && b.Date != d.Transaction.PostedAt.Date) { <span> · проведено @b.Local().ToString("dd.MM.yyyy")</span> }
            @if (d.Transaction.IsTransfer) { <span class="pill">перевод между своими счетами</span> }
            @if (d.Transaction.Status == TransactionStatus.Pending) { <span class="pill warn">в обработке</span> }
            @if (d.Transaction.Status == TransactionStatus.Cancelled) { <span class="pill err">отменена</span> }
        </div>
    </div>
</div>

@if (msg is not null) { <div class="alert ok">@msg</div> }

<div class="grid2">
    <div>
        <h2>Категория</h2>
        <div class="form">
            <label>Категория
                <select value="@(d.Transaction.CategoryId?.ToString() ?? "")" @onchange="e => SetCategory(e.Value?.ToString())">
                    <option value="">— без категории —</option>
                    @foreach (var c in categories.Where(c => c.Kind == (d.Transaction.IsIncome ? CategoryKind.Income : CategoryKind.Expense) || c.Kind == CategoryKind.Transfer || c.Kind == CategoryKind.Investment))
                    { <option value="@c.Id">@c.Label</option> }
                </select>
            </label>
            @if (d.Transaction.CategoryId is not null) { <div class="muted" style="font-size:12px">источник: @Src(d.Transaction.CategorySource)@(d.Transaction.CategoryConfidence is { } cf && d.Transaction.CategorySource != CategorySource.User ? $", уверенность {cf:P0}" : "")</div> }
            @if (d.Transaction.CategoryId is null && d.Transaction.ProposedCategoryId is not null)
            {
                <div>Предложено: @d.Transaction.ProposedCategoryLabel <button class="small primary" @onclick="Accept">Принять</button></div>
            }
            @if (d.Counterparty is not null)
            {
                <label style="flex-direction:row;align-items:center;gap:6px;display:flex"><input type="checkbox" @bind="applyToCounterparty" /> применять эту категорию ко всем операциям контрагента «@d.Counterparty.DisplayName»</label>
            }
        </div>

        <h2>Контрагент</h2>
        @if (d.Counterparty is not null)
        {
            <table class="kv">
                <tr><th>Кто</th><td><a href="/transactions?cp=@d.Counterparty.Id">@d.Counterparty.DisplayName</a> <span class="pill">@Counterparties.Kind(d.Counterparty.Kind)</span></td></tr>
                @if (d.Counterparty.Inn is not null) { <tr><th>ИНН</th><td>@d.Counterparty.Inn@(d.Counterparty.Kpp is not null ? $" / КПП {d.Counterparty.Kpp}" : "")</td></tr> }
                @if (d.Counterparty.AccountsMasked.Count > 0) { <tr><th>Счета</th><td class="muted">@string.Join(", ", d.Counterparty.AccountsMasked)</td></tr> }
                @if (d.Counterparty.PhonesMasked.Count > 0) { <tr><th>Телефоны</th><td class="muted">@string.Join(", ", d.Counterparty.PhonesMasked)</td></tr> }
                @if (d.Counterparty.DefaultCategoryId is { } dc && categories.FirstOrDefault(c => c.Id == dc) is { } dcat) { <tr><th>Категория по умолчанию</th><td>@dcat.Label</td></tr> }
            </table>
        }
        else { <p class="muted">Контрагент не определён.</p> }

        @if (!d.Raw.IsEmpty)
        {
            <details>
                <summary class="muted">Реквизиты из выписки</summary>
                <table class="kv">
                    @if (d.Raw.Name is not null) { <tr><th>Название</th><td>@d.Raw.Name</td></tr> }
                    @if (d.Raw.Inn is not null) { <tr><th>ИНН</th><td>@d.Raw.Inn</td></tr> }
                    @if (d.Raw.AccountMasked is not null) { <tr><th>Счёт</th><td>@d.Raw.AccountMasked</td></tr> }
                    @if (d.Raw.Bik is not null) { <tr><th>БИК</th><td>@d.Raw.Bik @d.Raw.BankName</td></tr> }
                    @if (d.Raw.PhoneMasked is not null) { <tr><th>Телефон</th><td>@d.Raw.PhoneMasked</td></tr> }
                </table>
            </details>
        }

        <h2>Заметка и теги</h2>
        <div class="form">
            <label>Заметка <textarea rows="2" @bind="note"></textarea></label>
            <label>Теги (через запятую) <input @bind="tags" placeholder="напр. налоги, аренда" /></label>
            <div><button class="primary" @onclick="SaveNote">Сохранить</button></div>
        </div>
    </div>

    <div>
        <h2>Детали</h2>
        <table class="kv">
            <tr><th>Счёт</th><td><a href="/transactions?account=@d.Transaction.AccountId">@d.Transaction.AccountName</a> <span class="muted">@d.AccountNumberMasked</span></td></tr>
            <tr><th>Профиль / банк</th><td>@d.ProfileName · @d.BankName</td></tr>
            @if (!string.IsNullOrWhiteSpace(d.Transaction.Purpose) && d.Transaction.Purpose != d.Transaction.Description) { <tr><th>Назначение платежа</th><td>@d.Transaction.Purpose</td></tr> }
            @if (d.Transaction.Mcc is not null) { <tr><th>MCC</th><td>@d.Transaction.Mcc</td></tr> }
            @if (d.Pair is not null)
            {
                <tr><th>Парная операция</th><td><a href="/transactions/@d.Pair.Id">@d.Pair.AccountName: @(d.Pair.IsIncome ? "+" : "−")@Math.Abs(d.Pair.Amount).ToString("N2") @d.Pair.PostedAt.Local().ToString("dd.MM.yyyy")</a></td></tr>
            }
        </table>

        <h2>Откуда эти данные</h2>
        <table class="kv">
            <tr><th>Источник</th><td>@SourceLabel(d.Source.Source)</td></tr>
            @if (d.Source.ConnectionName is not null) { <tr><th>Подключение</th><td><a href="/sources">@d.Source.ConnectionName</a>@(d.Source.SourceCode is not null ? $" · {d.Source.SourceCode}" : "")</td></tr> }
            @if (d.Source.FileName is not null) { <tr><th>Файл</th><td>@d.Source.FileName</td></tr> }
            @if (d.Source.LoadedAt is { } la) { <tr><th>Загружено</th><td>@la.Local().ToString("dd.MM.yyyy HH:mm")</td></tr> }
            @if (d.Source.ExternalId is not null) { <tr><th>Внешний ID</th><td class="muted">@d.Source.ExternalId</td></tr> }
            <tr><th>Импортировано</th><td class="muted">@d.Source.ImportedAt.Local().ToString("dd.MM.yyyy HH:mm")</td></tr>
        </table>
        @if (d.Source.RawPayload is not null)
        {
            <details><summary class="muted">Сырая запись из выписки</summary><pre class="raw">@d.Source.RawPayload</pre></details>
        }

        @if (d.Similar.Count > 0)
        {
            <h2>Похожие операции</h2>
            <table>
                <thead><tr><th>Дата</th><th>Описание</th><th>Категория</th><th class="num">Сумма</th></tr></thead>
                <tbody>
                @foreach (var r in d.Similar)
                {
                    <tr>
                        <td style="white-space:nowrap"><a href="/transactions/@r.Id">@r.PostedAt.Local().ToString("dd.MM.yy")</a></td>
                        <td>@r.Description</td>
                        <td class="muted">@(r.CategoryLabel ?? "—")</td>
                        <td class="num @(r.IsIncome ? "pos" : "neg")">@(r.IsIncome ? "+" : "")@r.Amount.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    TransactionDetailDto? d;
    IReadOnlyList<CategoryDto> categories = [];
    bool loaded, applyToCounterparty;
    string uid = "", note = "", tags = "";
    string? msg;

    protected override async Task OnParametersSetAsync()
    {
        uid = await Me.IdAsync();
        categories = await Q.CategoriesAsync(uid);
        await Load();
    }

    async Task Load()
    {
        d = await Q.TransactionAsync(uid, Id);
        loaded = true;
        if (d is not null) { note = d.Transaction.Note ?? ""; tags = string.Join(", ", d.Transaction.Tags); }
    }

    async Task SetCategory(string? value)
    {
        Guid? cat = Guid.TryParse(value, out var g) ? g : null;
        await Commands.SetCategoryAsync(uid, Id, cat, applyToCounterparty);
        msg = applyToCounterparty && cat is not null ? "Категория сохранена и применена к операциям контрагента." : "Категория сохранена.";
        await Load();
    }

    async Task Accept() { await Commands.AcceptProposalAsync(uid, Id); await Load(); }

    async Task SaveNote()
    {
        await Commands.SetNoteAsync(uid, Id, note, tags.Split(',', StringSplitOptions.RemoveEmptyEntries));
        msg = "Заметка сохранена.";
        await Load();
    }

    static string Src(CategorySource s) => s switch { CategorySource.User => "вручную", CategorySource.Rule => "правило", CategorySource.Mcc => "по MCC", CategorySource.Ai => "ИИ", CategorySource.Counterparty => "по контрагенту", _ => "" };
    static string SourceLabel(ConnectorType t) => t switch
    {
        ConnectorType.StatementImport => "файл выписки", ConnectorType.Manual => "введено вручную", ConnectorType.TInvest => "T-Invest API",
        ConnectorType.TBankBusiness => "T-API (Т-Бизнес)", ConnectorType.SberBusiness => "Sber API", ConnectorType.AlfaBusiness => "Alfa API", _ => t.ToString()
    };
}
