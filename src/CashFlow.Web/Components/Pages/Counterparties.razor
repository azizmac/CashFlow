@page "/counterparties"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject LedgerQueries Q
@inject CashFlow.Application.IUnitOfWork Uow

<PageTitle>Контрагенты — CashFlow</PageTitle>
<h1>Контрагенты</h1>
<p class="muted">Кто присылает деньги и кому они уходят. Категория по умолчанию применяется ко всем будущим (и неразобранным прошлым) операциям контрагента.</p>

<div class="toolbar">
    <input placeholder="Поиск" @bind="search" @bind:after="Reload" style="min-width:240px" />
    <select @bind="kind" @bind:after="Reload">
        <option value="">Все типы</option>
        @foreach (var k in Enum.GetValues<CounterpartyKind>()) { <option value="@k">@Kind(k)</option> }
    </select>
</div>

<table>
    <thead><tr><th>Название</th><th>Тип</th><th>ИНН</th><th>Категория по умолчанию</th><th class="num">Операций</th><th class="num">Ушло</th><th class="num">Пришло</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in rows)
    {
        <tr>
            <td>
                @if (editId == c.Cp.Id)
                {
                    <input @bind="editName" style="width:100%" />
                }
                else
                {
                    <a href="/transactions?cp=@c.Cp.Id">@c.Cp.DisplayName</a>
                    @if (c.Cp.Aliases.Count > 1) { <div class="muted" style="font-size:11px">также: @string.Join(", ", c.Cp.Aliases.Where(a => a != TextNormalizer.Normalize(c.Cp.DisplayName)).Take(3))</div> }
                }
            </td>
            <td>
                <select value="@c.Cp.Kind" @onchange="e => SetKind(c.Cp, e.Value?.ToString())">
                    @foreach (var k in Enum.GetValues<CounterpartyKind>()) { <option value="@k">@Kind(k)</option> }
                </select>
            </td>
            <td class="muted">@c.Cp.Inn</td>
            <td>
                <select value="@(c.Cp.DefaultCategoryId?.ToString() ?? "")" @onchange="e => SetDefaultCategory(c.Cp, e.Value?.ToString())" style="max-width:200px">
                    <option value="">—</option>
                    @foreach (var cat in categories) { <option value="@cat.Id">@cat.Icon @cat.Name</option> }
                </select>
            </td>
            <td class="num">@c.Count</td>
            <td class="num neg">@(c.Out > 0 ? c.Out.ToString("N0") : "")</td>
            <td class="num pos">@(c.In > 0 ? c.In.ToString("N0") : "")</td>
            <td style="white-space:nowrap">
                @if (editId == c.Cp.Id) { <button class="small primary" @onclick="() => SaveName(c.Cp)">Сохранить</button> }
                else { <button class="small" @onclick="() => { editId = c.Cp.Id; editName = c.Cp.DisplayName; }">✎</button> }
            </td>
        </tr>
    }
    </tbody>
</table>

@code {
    record Row(Counterparty Cp, int Count, decimal Out, decimal In);
    List<Row> rows = [];
    List<Category> categories = [];
    string? search, kind;
    Guid? editId; string editName = "";
    string uid = "";

    protected override async Task OnInitializedAsync()
    {
        uid = await Me.IdAsync();
        categories = Q.Categories(uid);
        await Reload();
    }

    Task Reload()
    {
        var cps = Q.Counterparties(uid);
        if (!string.IsNullOrWhiteSpace(search)) { var s = TextNormalizer.Normalize(search); cps = cps.Where(c => c.Aliases.Any(a => a.Contains(s)) || (c.Inn?.Contains(s) ?? false)).ToList(); }
        if (Enum.TryParse<CounterpartyKind>(kind, out var k)) cps = cps.Where(c => c.Kind == k).ToList();

        var ids = cps.Select(c => c.Id).ToList();
        var stats = Uow.Transactions.Query().Where(t => t.CounterpartyId != null && ids.Contains(t.CounterpartyId!.Value) && t.Kind != TransactionKind.Transfer)
            .Select(t => new { t.CounterpartyId, t.Amount.Amount }).ToList()
            .GroupBy(x => x.CounterpartyId!.Value)
            .ToDictionary(g => g.Key, g => (Count: g.Count(), Out: g.Where(x => x.Amount < 0).Sum(x => -x.Amount), In: g.Where(x => x.Amount > 0).Sum(x => x.Amount)));

        rows = cps.Select(c => { var s = stats.GetValueOrDefault(c.Id); return new Row(c, s.Count, s.Out, s.In); })
            .OrderByDescending(r => r.Out + r.In).ToList();
        return Task.CompletedTask;
    }

    async Task SetKind(Counterparty c, string? v) { if (Enum.TryParse<CounterpartyKind>(v, out var k)) { c.SetKind(k); await Uow.SaveChangesAsync(); } }

    async Task SetDefaultCategory(Counterparty c, string? v)
    {
        c.SetDefaultCategory(Guid.TryParse(v, out var g) ? g : null);
        if (c.DefaultCategoryId is { } cat)
        {
            var txs = Uow.Transactions.Query().Where(t => t.CounterpartyId == c.Id && !t.ReviewedByUser).ToList();
            foreach (var t in txs) t.Categorize(cat, CategorySource.Counterparty, 0.95m);
        }
        await Uow.SaveChangesAsync();
    }

    async Task SaveName(Counterparty c) { if (!string.IsNullOrWhiteSpace(editName)) c.Rename(editName.Trim()); editId = null; await Uow.SaveChangesAsync(); await Reload(); }

    public static string Kind(CounterpartyKind k) => k switch
    {
        CounterpartyKind.Person => "Человек", CounterpartyKind.Company => "Компания", CounterpartyKind.SoleProprietor => "ИП",
        CounterpartyKind.Bank => "Банк", CounterpartyKind.Government => "Государство", CounterpartyKind.Merchant => "Магазин/сервис", CounterpartyKind.Self => "Я (свои счета)", _ => "Не определён"
    };
}
