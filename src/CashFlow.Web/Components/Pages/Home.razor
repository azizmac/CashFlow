@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject ILedgerQueries Q
@using CashFlow.Application
@using CashFlow.Application.Contracts

<PageTitle>Обзор — CashFlow</PageTitle>
<h1>Обзор</h1>

@if (profiles is null || summary is null) { <p class="muted">Загрузка…</p> return; }

<div class="toolbar">
    <select @bind="profileId" @bind:after="Reload">
        <option value="">Все профили (сводно)</option>
        @foreach (var p in profiles) { <option value="@p.Id">@p.Name</option> }
    </select>
    <select @bind="months" @bind:after="Reload">
        <option value="1">Текущий месяц</option>
        <option value="3">3 месяца</option>
        <option value="6">6 месяцев</option>
        <option value="12">12 месяцев</option>
    </select>
    <span class="muted">@from.ToString("dd.MM.yyyy") — @to.ToString("dd.MM.yyyy")</span>
</div>

<div class="cards">
    <div class="card"><div class="label">Доходы</div><div class="value pos">+@summary.Income.ToString("N0") ₽</div></div>
    <div class="card"><div class="label">Расходы</div><div class="value neg">−@summary.Expense.ToString("N0") ₽</div></div>
    <div class="card"><div class="label">Сальдо</div><div class="value @((summary.Income - summary.Expense) >= 0 ? "pos" : "neg")">@((summary.Income - summary.Expense).ToString("N0")) ₽</div></div>
    <div class="card"><div class="label">Чистые активы (по остаткам)</div><div class="value">@summary.NetWorth.ToString("N0") ₽</div></div>
</div>

@if (summary.Income == 0 && summary.Expense == 0)
{
    <div class="alert info">Данных пока нет. <a href="/sources">Загрузите выписку</a> или <a href="/connections">подключите API</a>.</div>
}
@if (stale.Count > 0)
{
    <div class="alert warn">Данные устарели: @string.Join("; ", stale.Take(3).Select(s => $"«{s.Account.Name}» — последняя операция {s.Last:dd.MM.yyyy}"))@(stale.Count > 3 ? $" и ещё {stale.Count - 3}" : ""). <a href="/sources">Догрузить выписки</a></div>
}

<div class="grid2">
    <div>
        <h2>Куда уходят деньги</h2>
        <table>
            <thead><tr><th>Категория</th><th class="num">Сумма</th><th class="num">Опер.</th><th style="width:30%"></th></tr></thead>
            <tbody>
            @foreach (var c in summary.ByCategory.Take(15))
            {
                <tr>
                    <td>@c.Label @if (c.CategoryId is null) { <a class="small" href="/transactions?uncategorized=1"> → разобрать</a> }</td>
                    <td class="num">@c.Total.ToString("N0")</td>
                    <td class="num muted">@c.Count</td>
                    <td><div class="bar"><div style="width:@(summary.Expense > 0 ? (int)(c.Total / summary.Expense * 100) : 0)%"></div></div></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div>
        <h2>Кому уходят деньги</h2>
        <table>
            <thead><tr><th>Контрагент</th><th class="num">Сумма</th><th class="num">Опер.</th></tr></thead>
            <tbody>
            @foreach (var c in summary.ByCounterparty)
            {
                <tr>
                    <td><a href="/transactions?cp=@c.CounterpartyId">@c.Name</a> <span class="pill">@Kind(c.Kind)</span></td>
                    <td class="num">@c.Total.ToString("N0")</td>
                    <td class="num muted">@c.Count</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    IReadOnlyList<ProfileDto>? profiles;
    SummaryDto? summary;
    List<AccountCoverageDto> stale = [];
    string? profileId;
    int months = 1;
    DateOnly from, to;
    string uid = "";

    protected override async Task OnInitializedAsync()
    {
        uid = await Me.IdAsync();
        profiles = await Me.ProfilesAsync();
        await Reload();
    }

    async Task Reload()
    {
        var today = DateOnly.FromDateTime(DateTime.Now);
        to = today;
        from = months == 1 ? new DateOnly(today.Year, today.Month, 1) : today.AddMonths(-months);
        Guid? pid = Guid.TryParse(profileId, out var g) ? g : null;
        summary = await Q.SummaryAsync(uid, pid, from, to);
        stale = (await Q.CoverageAsync(uid, pid)).Where(c => c.Count > 0 && c.StaleDays > 30 && c.Account.IncludeInCashFlow).ToList();
    }

    static string Kind(CounterpartyKind k) => k switch
    {
        CounterpartyKind.Person => "человек", CounterpartyKind.Company => "компания", CounterpartyKind.SoleProprietor => "ИП",
        CounterpartyKind.Bank => "банк", CounterpartyKind.Government => "гос.", CounterpartyKind.Merchant => "магазин", CounterpartyKind.Self => "я", _ => "?"
    };
}
