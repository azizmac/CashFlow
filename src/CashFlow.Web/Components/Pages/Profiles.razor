@page "/profiles"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject IProfileService Svc
@using CashFlow.Application
@using CashFlow.Application.Contracts

<PageTitle>Профили — CashFlow</PageTitle>
<h1>Финансовые профили</h1>
<p class="muted">Физлицо и ИП — отдельные профили одного пользователя. ИНН нужен, чтобы переводы «с р/с ИП на свою карту» автоматически распознавались как перевод самому себе, а не доход. ИНН хранится в зашифрованном виде.</p>

@if (profiles is null) { <p class="muted">Загрузка…</p> return; }

<table>
    <thead><tr><th>Название</th><th>Тип</th><th>ИНН</th></tr></thead>
    <tbody>
    @foreach (var p in profiles)
    {
        <tr>
            <td><input value="@p.Name" @onchange="e => Rename(p, e.Value?.ToString())" /></td>
            <td class="muted">@Kind(p.Kind)</td>
            <td><input value="@p.Inn" placeholder="ИНН" maxlength="12" @onchange="e => SetInn(p, e.Value?.ToString())" /></td>
        </tr>
    }
    </tbody>
</table>

<h2>Добавить профиль</h2>
<div class="form">
    <label>Название <input @bind="name" placeholder="напр. ИП Иванов" /></label>
    <label>Тип <select @bind="kind"><option value="@ProfileKind.Individual">Физлицо</option><option value="@ProfileKind.SoleProprietor">ИП</option><option value="@ProfileKind.Company">Компания</option></select></label>
    <label>ИНН <input @bind="inn" maxlength="12" /></label>
    <button class="primary" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(name)">Добавить</button>
</div>

@code {
    IReadOnlyList<ProfileDto>? profiles;
    string uid = "", name = "", inn = ""; ProfileKind kind = ProfileKind.SoleProprietor;

    protected override async Task OnInitializedAsync() { uid = await Me.IdAsync(); profiles = await Svc.ListAsync(uid); }

    async Task Rename(ProfileDto p, string? v) { if (!string.IsNullOrWhiteSpace(v)) { await Svc.RenameAsync(uid, p.Id, v); profiles = await Svc.ListAsync(uid); } }
    async Task SetInn(ProfileDto p, string? v) { await Svc.SetInnAsync(uid, p.Id, v); profiles = await Svc.ListAsync(uid); }

    async Task Add()
    {
        await Svc.CreateAsync(uid, kind, name, inn);
        name = ""; inn = "";
        profiles = await Svc.ListAsync(uid);
    }

    static string Kind(ProfileKind k) => k switch { ProfileKind.SoleProprietor => "ИП", ProfileKind.Company => "Компания", _ => "Физлицо" };
}
