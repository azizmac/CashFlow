@page "/accounts"
@attribute [Authorize]
@rendermode InteractiveServer
@inject CurrentUser Me
@inject LedgerQueries Q
@inject CashFlow.Application.IUnitOfWork Uow

<PageTitle>Счета — CashFlow</PageTitle>
<h1>Счета</h1>

@if (profiles is null) { <p class="muted">Загрузка…</p> return; }

<table>
    <thead><tr><th>Счёт</th><th>Профиль</th><th>Банк</th><th>Тип</th><th>Номер</th><th class="num">Остаток</th><th>Обновлён</th><th>Учитывать</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in accounts)
    {
        <tr>
            <td><a href="/transactions?account=@a.Id&transfers=1">@a.Name</a></td>
            <td class="muted">@profiles.FirstOrDefault(p => p.Id == a.ProfileId)?.Name</td>
            <td class="muted">@institutions.GetValueOrDefault(a.InstitutionId)?.Name</td>
            <td><span class="pill">@Type(a.Type)</span></td>
            <td class="muted">@Mask(a.AccountNumber)</td>
            <td class="num">@(a.LastBalance is { } b ? $"{b.Amount:N2} {b.Currency.Code}" : "—")</td>
            <td class="muted">@(a.LastBalanceAt?.Local().ToString("dd.MM.yy") ?? "")</td>
            <td>
                <label><input type="checkbox" checked="@a.IncludeInCashFlow" @onchange="e => Flags(a, cf: (bool)e.Value!)" /> в потоке</label><br/>
                <label><input type="checkbox" checked="@a.IncludeInNetWorth" @onchange="e => Flags(a, nw: (bool)e.Value!)" /> в активах</label>
            </td>
            <td><button class="small" @onclick="() => Archive(a)">в архив</button></td>
        </tr>
    }
    </tbody>
</table>

<h2>Добавить ручной счёт (наличные и т.п.)</h2>
<div class="form">
    <label>Название <input @bind="newName" /></label>
    <label>Профиль <select @bind="newProfile">@foreach (var p in profiles) { <option value="@p.Id">@p.Name</option> }</select></label>
    <label>Тип <select @bind="newType">@foreach (var t in Enum.GetValues<AccountType>()) { <option value="@t">@Type(t)</option> }</select></label>
    <label>Валюта <input @bind="newCurrency" maxlength="3" /></label>
    <label>Текущий остаток <input type="number" step="0.01" @bind="newBalance" /></label>
    <button class="primary" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(newName)">Добавить</button>
</div>

@code {
    List<FinancialProfile>? profiles;
    List<Account> accounts = [];
    Dictionary<Guid, Institution> institutions = new();
    string uid = "";
    string newName = "", newProfile = "", newCurrency = "RUB"; AccountType newType = AccountType.Cash; decimal newBalance;

    protected override async Task OnInitializedAsync()
    {
        uid = await Me.IdAsync();
        profiles = await Me.ProfilesAsync();
        newProfile = profiles[0].Id.ToString();
        institutions = Q.Institutions().ToDictionary(i => i.Id);
        accounts = Q.Accounts(uid);
    }

    async Task Flags(Account a, bool? cf = null, bool? nw = null) { a.SetFlags(nw ?? a.IncludeInNetWorth, cf ?? a.IncludeInCashFlow); await Uow.SaveChangesAsync(); }
    async Task Archive(Account a) { a.Archive(); await Uow.SaveChangesAsync(); accounts = Q.Accounts(uid); }

    async Task Add()
    {
        var inst = institutions.Values.First(i => i.Code == (newType == AccountType.Cash ? Institution.Codes.Cash : Institution.Codes.Other));
        var a = new Account(uid, Guid.Parse(newProfile), inst.Id, newType, newName.Trim(), Currency.Parse(newCurrency));
        await Uow.Accounts.AddAsync(a);
        await Uow.BalanceSnapshots.AddAsync(a.RecordBalance(new Money(newBalance, a.Currency)));
        await Uow.SaveChangesAsync();
        newName = ""; newBalance = 0;
        accounts = Q.Accounts(uid);
    }

    static string Mask(string? n) => string.IsNullOrEmpty(n) ? "" : n.Length > 4 ? "…" + n[^4..] : n;
    public static string Type(AccountType t) => t switch
    {
        AccountType.Checking => "Расчётный", AccountType.Card => "Карта", AccountType.Savings => "Накопительный", AccountType.Deposit => "Вклад",
        AccountType.CreditCard => "Кредитная карта", AccountType.Loan => "Кредит", AccountType.Brokerage => "Брокерский", AccountType.Iis => "ИИС",
        AccountType.Cash => "Наличные", AccountType.EWallet => "Кошелёк", _ => t.ToString()
    };
}
