<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="_content/CashFlow.UI/app.css" />
    <link rel="stylesheet" href="@Assets["CashFlow.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @* Глобальная интерактивность: страницы общей библиотеки CashFlow.UI не знают о режимах рендеринга (в MAUI их нет).
       Страницы Identity помечены [ExcludeFromInteractiveRouting] и остаются статическими. *@
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
